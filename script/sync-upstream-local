#!/usr/bin/env bash

set -euo pipefail

branch="${1:-smooth-cursor}"
upstream_remote="${UPSTREAM_REMOTE:-upstream}"
upstream_branch="${UPSTREAM_BRANCH:-main}"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "This command must be run inside a real Git clone of Zed." >&2
  exit 1
fi

git fetch "$upstream_remote" "$upstream_branch"
git checkout "$branch"
git merge --no-ff "${upstream_remote}/${upstream_branch}"

echo
echo "Upstream merge completed on branch: $branch"
echo "Next recommended steps:"
echo "  cargo check -p editor"
echo "  ./script/bundle-mac aarch64-apple-darwin"
